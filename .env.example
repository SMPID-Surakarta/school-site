# ─── Database ───────────────────────────────────────────────────────────────
# PostgreSQL 16+ connection string
DATABASE_URL="postgres://user:password@localhost:5432/websmk"

# ─── Auth.js ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (must be >= 32 chars)
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"

# ─── Media storage (local disk) ────────────────────────────────────────────────
# Directory for uploaded files (relative to the process cwd, or absolute).
# Images are compressed to WebP/AVIF on upload; files are served from /uploads/*.
UPLOAD_DIR="uploads"

# ─── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV="development"

# WhatsApp gateway (set all three values to forward contact messages)
WA_API_KEY=""
WA_SENDER="628xxxxxxxxxx"
WA_RECIPIENT="628xxxxxxxxxx"
